def count_frequency(arr):
    frequency = {}
    
    for num in arr:
        if num in frequency:
            frequency[num] += 1
        else:
            frequency[num] = 1
            
    for key, value in frequency.items():
        unit = "time" if value == 1 else "times"
        print(f"{key} -> {value} {unit}")

arr = [1, 2, 2, 3, 1, 4, 2]
count_frequency(arr)
